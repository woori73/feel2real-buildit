# .env.example (git에 올리는 형식 예시)
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
# BuildIt Chart Research Agent (server secret storage only — never commit a value)
CHART_AGENT_TOKEN=
# BuildIt Wiki AI Router (values must remain in local/server secret storage)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OX_ALPHA_MODEL=stealth/ox-alpha
AI_PROVIDER_TIMEOUT_SECONDS=45
# NVIDIA NIM (지피지기 PRIMARY — provider 'nvidia'; 'newstart' 프로파일의 availability fallback)
NVIDIA_API_KEY=
NVIDIA_NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_NEMOTRON_ULTRA_MODEL=
# 지피지기 라우팅 체인 (PRIMARY 실패 시에만 1회 전환 — 품질 라우팅 아님)
NEWSTART_PRIMARY_PROVIDER=nvidia
NEWSTART_FALLBACK_PROVIDER=qwen
