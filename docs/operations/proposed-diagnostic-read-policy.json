{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ProposedRdsReadMetadataOnlyNotApplied",
      "Effect": "Allow",
      "Action": [
        "rds:DescribeDBInstances",
        "rds:DescribeDBSnapshots",
        "rds:DescribeAccountAttributes"
      ],
      "Resource": "*",
      "Condition": {"StringEquals": {"aws:RequestedRegion": "ap-northeast-2"}}
    },
    {
      "Sid": "ProposedExistingRoleSimulationOnlyNotApplied",
      "Effect": "Allow",
      "Action": "iam:SimulatePrincipalPolicy",
      "Resource": "arn:aws:iam::425805163960:role/github-actions-f2r-deploy"
    }
  ]
}
