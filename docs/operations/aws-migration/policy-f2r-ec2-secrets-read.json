{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadAppParametersOnly",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath"
      ],
      "Resource": [
        "arn:aws:ssm:ap-northeast-2:425805163960:parameter/f2r/app",
        "arn:aws:ssm:ap-northeast-2:425805163960:parameter/f2r/app/*"
      ]
    },
    {
      "Sid": "ReadDeployBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::f2r-deploy-425805163960",
        "arn:aws:s3:::f2r-deploy-425805163960/*"
      ]
    }
  ]
}
