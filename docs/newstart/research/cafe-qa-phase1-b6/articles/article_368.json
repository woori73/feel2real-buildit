de9\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-47a96166-fba1-4c31-901e-820601c3ea95\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-5569363a-68a8-452e-9b97-1dd61daad655\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-b8397def-5857-424f-a390-c2991a7a3a31\">부동의 경우도 있답니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-403e9a5e-7eac-4f23-91ef-0bfad2db387c\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-1c3ea8fe-d4ab-4bc4-b39d-e90348cfa9d6\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-f40b4641-7dee-42cc-9104-3f3b2f302af0\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-eca18403-0084-492f-b0fe-43a7d1a9c723\">그럼 추심도 덜할거구요.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-b707ac44-f39a-424d-8635-94899c04c84f\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-adef7948-b72e-4b72-9a34-47ba25428522\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-4f5c4d83-f5d0-4c0e-970e-b318c78657ee\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-9e24dce9-d35a-4de8-8c18-7209f7e17783\">가압류는 걸리겠죠.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-cf3295dd-41cf-4846-b151-495ecc2692de\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-35827068-438b-4195-929e-6102f60e0e13\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-89c6867e-d03b-4b9f-8905-0c6e3ac78548\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-0fb63a41-d000-4f73-885a-174df5d2dd4d\">그리고 저는 재산과 부채비율이 비슷해서 감면은 마니 안될거라고합니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p clas