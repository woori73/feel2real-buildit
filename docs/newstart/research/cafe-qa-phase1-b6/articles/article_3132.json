   "memberGrade": null,
   "createdAt": "2025-12-26T01:19:03.000Z",
   "createdAtMs": 1766711943000,
   "text": "1건 양도된다고 우편왔어요",
   "isAuthor": false,
   "isOperator": false,
   "isDeleted": false,
   "sourceType": "CAFE_COMMENT"
  },
  {
