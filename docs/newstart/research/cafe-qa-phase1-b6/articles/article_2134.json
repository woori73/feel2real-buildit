   "createdAt": "2025-12-30T14:27:35.000Z",
   "createdAtMs": 1767104855000,
   "text": "전  부실우려대 삼",
   "isAuthor": false,
   "isOperator": false,
   "isDeleted": false,
   "sourceType": "CAFE_COMMENT"
  },
  {
