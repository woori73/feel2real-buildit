   "author": "HN",
   "memberGrade": null,
   "createdAt": "2025-11-26T15:07:11.000Z",
   "createdAtMs": 1764169631000,
   "text": "네 한도만 주는게 일반적입니다.",
   "isAuthor": false,
   "isOperator": false,
   "isDeleted": false,
   "sourceType": "CAFE_COMMENT"
  },
  {
