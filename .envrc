# direnv 설정: 프로젝트 디렉터리에 진입할 때만 환경변수를 로드한다.
# 실제 비밀값은 repo 바깥(~/.config/f2r/env)에 두고, 모든 worktree가 자동 공유한다.
#
# 처음 사용 시 또는 .envrc를 수정한 뒤에는 worktree 루트에서 `direnv allow` 1회 실행.
# direnv 미설치 환경에서는 이 파일은 무시되므로 빌드/배포에 영향 없다.

if [ -f "$HOME/.config/f2r/env" ]; then
  source "$HOME/.config/f2r/env"
fi

# 브랜치가 바뀌면 direnv가 이 파일을 다시 평가하도록 HEAD를 watch한다.
# direnv는 디렉터리 진입/.envrc 변경 시에만 평가하므로, 이게 없으면 `git switch dev` 후에도
# 이전 브랜치 기준 env(= worktree DB override)가 그대로 남는다.
# worktree마다 HEAD 위치가 다르다(루트=.git/HEAD, worktree=.git/worktrees/<name>/HEAD).
watch_file "$(git rev-parse --git-path HEAD 2>/dev/null || echo .git/HEAD)"

# worktree별 override가 필요하면 .envrc.local에 추가 (gitignore됨).
# 단, scripts/worktree-db.sh가 생성한 worktree DB override는 티어 브랜치에서 무시한다.
# 티어 DB는 각 profile yaml이 담당해야 하기 때문: main=3308/f2r_db, dev=3309/f2r_dev, stg=3310/f2r_stg.
# (worktree에서 dev/stg를 checkout해 검증할 때 worktree DB로 잘못 붙는 것을 막는다.)
if [ -f .envrc.local ]; then
  F2R_CURRENT_BRANCH="$(git branch --show-current 2>/dev/null || true)"
  case "${F2R_CURRENT_BRANCH}" in
    main|dev|stg) F2R_TIER_BRANCH=1 ;;
    *)            F2R_TIER_BRANCH=0 ;;
  esac
  if [ "${F2R_TIER_BRANCH}" = "1" ] && grep -q "Generated by scripts/worktree-db.sh" .envrc.local 2>/dev/null; then
    echo "Skipping generated worktree DB override on ${F2R_CURRENT_BRANCH}: .envrc.local"
  else
    source .envrc.local
  fi
  unset F2R_CURRENT_BRANCH F2R_TIER_BRANCH
fi
