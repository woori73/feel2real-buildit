    {
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nconst task = String(body.task ?? 'generate_questions');\nconst required = ['school','grade','exam'];\nconst missing = required.filter((key) => !String(body[key] ?? '').trim());\nif (missing.length) throw new Error(`missing_fields:${missing.join(',')}`);\nconst requirements = body.requirements ?? [body.grammar, body.difficulty].filter(Boolean);\nreturn [{json:{...body, task, source_passage:String(body.source_passage ?? body.passage ?? ''), requirements, question_count:Number(body.question_count ?? body.count ?? 3), digital_twin:'auto'}}];"
      },
      "id": "normalize-contract",
      "name": "Validate BuildIt Contract",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-480, 0]
    },
    {
      "parameters": {
        "rules": {"values": [
          {"conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"}, "conditions": [{"leftValue": "={{ $json.task }}", "rightValue": "ingest_source", "operator": {"type": "string", "operation": "equals"}}], "combinator": "and"}, "renameOutput": true, "outputKey": "source"},
          {"conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"}, "conditions": [{"leftValue": "={{ $json.task }}", "rightValue": "generate_questions", "operator": {"type": "string", "operation": "equals"}}], "combinator": "and"}, "renameOutput": true, "outputKey": "generate"}
        ]},
        "options": {"fallbackOutput": "extra"}
      },
      "id": "route-task",
      "name": "Route Task",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [-240, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BUILDIT_BASE_URL + '/problem-generator/wiki/api/automation/digital-twin/sources' }}",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {"parameters": [
          {"name": "school", "value": "={{ $json.school }}"},
          {"name": "grade", "value": "={{ $json.grade }}"},
          {"name": "exam", "value": "={{ $json.exam }}"},
          {"name": "material_type", "value": "={{ $json.material_type ?? 'past_exam' }}"},
          {"parameterType": "formBinaryData", "name": "file", "inputDataFieldName": "data"}
        ]},
        "options": {"timeout": 120000}
      },
