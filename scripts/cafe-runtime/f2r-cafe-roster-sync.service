[Unit]
Description=Append verified cafe thanks members to NewStart roster
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/opt/f2r-cafe-runtime/venv/bin/python /opt/f2r-cafe-runtime/roster_outbox.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ec2-user/f2r-cafe-browser/roster-outbox /var/lib/f2r-ebook
