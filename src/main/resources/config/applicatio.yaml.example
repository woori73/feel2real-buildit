spring:
  application:
    name: private_tutor_solution_back
  datasource:
    url: jdbc:mysql://localhost:3307/f2r_db
    username:
    password:
    driver-class-name: com.mysql.cj.jdbc.Driver
  jpa:
    hibernate:
      ddl-auto: validate  # init.sql로 이미 테이블 만들었으니까
    show-sql: true
    properties:
      hibernate:
        format_sql: true
        dialect: org.hibernate.dialect.MySQLDialect